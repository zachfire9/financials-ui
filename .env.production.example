# Production/static hosting example.
# Copy to .env.production locally or set these variables in your deployment environment.
# Keep real deployed URLs, API keys, and private runtime values out of commits.

# Use the deployed API Gateway base URL for the matching Financials API stack.
VITE_FINANCIALS_API_BASE_URL=https://<api-id>.execute-api.<aws-region>.amazonaws.com

# Static AWS hosting should use browser-owned session mode until deployed access control exists.
VITE_FINANCIALS_SESSION_MODE=ephemeral
